# syntax=docker/dockerfile:1
# This image intentionally targets linux/amd64: all downloaded tools match it.
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS tools
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
# Official release assets. Never run a mutable installation script.
RUN curl -fsSL --retry 3 https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64-baseline.zip -o /tmp/bun.zip \
    && echo 'a063908ae08b7852ca10939bbdc6ceed3ddabce8fb9402dce83d65d73b36e6c7  /tmp/bun.zip' | sha256sum -c - \
    && unzip -q /tmp/bun.zip -d /tmp/bun \
    && install -m 0755 /tmp/bun/bun-linux-x64-baseline/bun /usr/local/bin/bun \
    && rm -rf /tmp/bun /tmp/bun.zip
RUN curl -fsSL --retry 3 https://github.com/smartcontractkit/cre-cli/releases/download/v1.39.0/cre_linux_amd64_ldd2-35.tar.gz -o /tmp/cre.tar.gz \
    && echo '398ca2c354d1814767583753dab226e08370d5ecc11589f50f8833fbf1607ed4  /tmp/cre.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/cre.tar.gz -C /tmp cre_v1.39.0_linux_amd64 \
    && install -m 0755 /tmp/cre_v1.39.0_linux_amd64 /usr/local/bin/cre \
    && rm /tmp/cre.tar.gz /tmp/cre_v1.39.0_linux_amd64
# SDK 1.23.0 uses Javy 8.1.0 and its bundled prebuilt plugin. Populate the
# SDK's exact cache location, so compilation does not fetch another compiler.
RUN curl -fsSL --retry 3 https://github.com/bytecodealliance/javy/releases/download/v8.1.0/javy-x86_64-linux-v8.1.0.gz -o /tmp/javy.gz \
    && echo '043374b46076cd4408182c02a6f1b9e255806689f5b4b19a446734be0f7c7a6d  /tmp/javy.gz' | sha256sum -c - \
    && mkdir -p /root/.cache/javy/v8.1.0/linux-x64 \
    && gunzip -c /tmp/javy.gz > /root/.cache/javy/v8.1.0/linux-x64/javy \
    && chmod 0755 /root/.cache/javy/v8.1.0/linux-x64/javy \
    && rm /tmp/javy.gz
RUN node --version && bun --version && cre version

FROM tools AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY cre/bell-market-event/package.json cre/bell-market-event/package-lock.json ./cre/bell-market-event/
RUN npm --prefix cre/bell-market-event ci --ignore-scripts --no-audit --no-fund
COPY cre/bell-market-event/tsconfig.json ./cre/bell-market-event/tsconfig.json
COPY cre/bell-market-event/src/ ./cre/bell-market-event/src/
RUN cd cre/bell-market-event && bun node_modules/@chainlink/cre-sdk/bin/cre-compile.ts src/main.ts /app/workflow.wasm
COPY services/cre-worker/main.ts services/cre-worker/worker.ts services/cre-worker/verify.ts ./services/cre-worker/
COPY deployments/arc-optional-cover.json ./deployments/arc-optional-cover.json

FROM build AS checked
COPY services/cre-worker/test/ ./services/cre-worker/test/
COPY cre/bell-market-event/tests/fixtures.ts ./cre/bell-market-event/tests/fixtures.ts
COPY cre/bell-market-event/fixtures/reopen.json ./cre/bell-market-event/fixtures/reopen.json
RUN npm run test:cre-worker

FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/home /data/tmp /jobs && chown -R node:node /data
ENV NODE_ENV=production HOME=/data/home TMPDIR=/data/tmp \
    BELL_WORKER_DATA_DIR=/data BELL_WORKER_JOBS_DIR=/jobs \
    BELL_WORKER_MODE=dry-run BELL_WORKER_POLL_MS=5000
COPY --from=tools /usr/local/bin/cre /usr/local/bin/cre
COPY --from=checked /app/package.json ./package.json
COPY --from=checked /app/node_modules/ ./node_modules/
COPY --from=checked /app/cre/bell-market-event/node_modules/ ./cre/bell-market-event/node_modules/
COPY --from=checked /app/cre/bell-market-event/src/ ./cre/bell-market-event/src/
COPY --from=checked /app/services/cre-worker/main.ts /app/services/cre-worker/worker.ts /app/services/cre-worker/verify.ts ./services/cre-worker/
COPY --from=checked /app/deployments/arc-optional-cover.json ./deployments/arc-optional-cover.json
COPY --from=checked /app/workflow.wasm ./workflow.wasm
USER node
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["node", "--import", "tsx", "services/cre-worker/main.ts", "--health"]
ENTRYPOINT ["node", "--import", "tsx", "services/cre-worker/main.ts"]
