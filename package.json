{
  "name": "bell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frontend": "npm run abi:check && npm run typecheck && vite build",
    "abi:generate": "node --import tsx scripts/generate-browser-abis.ts",
    "abi:check": "node --import tsx scripts/generate-browser-abis.ts --check",
    "test:frontend": "node --import tsx --test tests/frontend/*.test.ts tests/unit/frontend.test.ts",
    "test:visual": "playwright test tests/visual --config playwright.config.ts --output test-results/visual",
    "test:browser": "playwright test tests/browser --config playwright.config.ts --output test-results/browser",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "lint": "npm run typecheck",
    "build": "npm run typecheck && forge build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:engine",
    "test:cre": "npm --prefix cre/bell-market-event test",
    "typecheck:cre": "npm --prefix cre/bell-market-event run typecheck",
    "build:cre": "npm --prefix cre/bell-market-event run build",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node scripts/not-implemented.mjs integration",
    "test:e2e": "node scripts/not-implemented.mjs e2e",
    "test:engine": "node --import tsx --test engine/*.test.ts",
    "verify:parity": "npm run test:engine && forge test --match-path contracts/test/differential/EngineDiff.t.sol",
    "verify:replay": "node --import tsx services/keeper/cli.ts replay",
    "test:keeper": "node --import tsx --test services/keeper/test/*.test.ts",
    "verify:workspace": "npm run typecheck && forge build && npm run test:unit",
    "verify": "npm run format:check && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e && npm run verify:parity && npm run verify:replay"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  }
}
