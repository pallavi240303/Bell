# Enter these in Coolify Environment Variables; values below contain no credentials.
BELL_WORKER_MODE=dry-run
BELL_WORKER_POLL_MS=5000
# Required to execute any job on a clean hosted worker. Leave empty for idle startup.
CRE_API_KEY=
# Required only for explicitly enabled broadcast mode: dedicated Arc Testnet report signer.
CRE_ETH_PRIVATE_KEY=
# Required only when a job selects dataSource=quote-snapshot.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
